# OS / editor cruft
.DS_Store

# Python bytecode
__pycache__/
*.py[cod]

# LaTeX build byproducts (keep .tex and .pdf)
*.aux
*.out
*.toc
*.synctex.gz
writeup/*.log
writeup/p[0-9].log

# Secrets — never commit
.env

# Repair snapshots written by the sourcing/annotation fix chain
# (.pre_idfix, .pre_backtranslate, .pre_template_fix, .pre_battery_tag,
# .pre_route_tag, .pre_provenance_recovery, .pre_wording_review).
# 364 MB of superseded intermediate state — every repair they snapshot has been
# applied and verified. Kept on disk for a local revert; never in history.
*.pre_idfix
*.pre_backtranslate
*.pre_template_fix
*.pre_battery_tag
*.pre_route_tag
*.pre_provenance_recovery
*.pre_wording_review
*.tmpmv

# Resumable API-lookup cache (regenerable, read-only Wikipedia)
data/_provenance_cache.json

# Live run outputs and logs (regenerable; annotations/<run_id>/ is run state)
annotations/full_v1/
annotations/panel_pilot/
# Judge-panel pilot/bake-off run state: same category as full_v1 -- regenerable
# run output, not source. See docs/MULTI_JUDGE_PLAN.md.
logs/
logs_*.txt
pipeline/data_clean.RData
Rplots.pdf
